# Public URL of the app (http://localhost:3000 while developing)
BETTER_AUTH_URL=http://localhost:3000

# Random string, at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# MongoDB connection string (Atlas free tier works fine)
MONGODB_URI=
MONGODB_DB_NAME=bazardor

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Product data API
NEXT_PUBLIC_API_BASE_URL=https://api.api-store.workers.dev/api/bazardor
